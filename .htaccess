# Arcade Perdido · Apache (mod_rewrite). Todo lo que no sea un archivo real lo resuelve index.php.
Options -Indexes -MultiViews
DirectoryIndex index.php index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Si la web está en una subcarpeta y algo falla, descomenta y ajusta:
  # RewriteBase /retrogames/

  # robots.txt y sitemap.xml los genera index.php
  RewriteRule ^(robots\.txt|sitemap\.xml)$ index.php [L]

  # Juegos arcade con URL antigua (/pwa/pivote.html?lang=en, /pwa/pivote) → index.php los redirige a /pivote (o /pivote/en)
  RewriteRule ^pwa/(?!index)[a-z0-9]+(\.html)?$ index.php [L]
  # Índices de la PWA (/pwa/, /pwa/indexpro, /pwa/indextv): los sirve index.php (dan 404 si PORTADA = false)
  RewriteRule ^pwa/(index(pro|tv|mesa)?(\.html)?)?$ index.php [L]

  # La portada de los educativos es la de index.php
  RewriteRule ^educativos/?$ /coleccion/educativos [R=301,L]
  RewriteRule ^educativos/index(\.html)?$ /coleccion/educativos [R=301,L]

  # Visor de la base de datos (phpLiteAdmin, con contraseña): es lo único de data/ que se sirve
  RewriteRule ^data/julkadmin\.php$ - [L]

  # Archivos internos y código descargable: nunca se sirven
  RewriteRule ^(data|herramientas|autonomos)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(sqlite|sqlite3|db|py|md|txt|sh|json\.bak)$ - [F,L,NC]

  # /index.html (la antigua portada estática) → index.php lo redirige a /
  RewriteRule ^index\.html$ index.php [L]

  # Sin .html en las URLs: /carpeta/index.html → /carpeta/ y /pagina.html → /pagina (solo lo que pide el navegador;
  # los minijuegos de Brain Academy se cargan dentro de un marco y no se tocan)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/educativos/brain-academy/games/
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]
  # …y /pagina sirve pagina.html si existe
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # URLs amigables
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # El HTML siempre se revalida: así cada página pide la versión correcta de sus .js
  <FilesMatch "\.(html|php|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # .js y .css: con huella (?v=…, la pone «arcade.php huellas» y también index.php al servir cada juego) se guardan un año,
  # porque si el archivo cambia cambia la URL; sin huella siempre se revalidan, para no usar nunca uno viejo.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
</IfModule>

